<figure id="research-trial" class="mt-4 mb-4">
  <video
    class="d-block w-100"
    width="960"
    height="312"
    controls
    muted
    playsinline
    preload="auto"
    aria-label="Slow-motion video of a mouse choosing the right port, alongside ten synchronized Neuropixels voltage traces"
    poster="{{ '/assets/img/research-trial/poster.jpg' | relative_url | bust_file_cache }}"
  >
    <source src="{{ '/assets/img/research-trial/trial.webm' | relative_url | bust_file_cache }}" type="video/webm">
    <source src="{{ '/assets/img/research-trial/trial.mp4' | relative_url | bust_file_cache }}" type="video/mp4">
  </video>
  <figcaption class="caption text-left mt-2">
    Video plays at one-quarter speed. The traces show 60 ms of Neuropixels voltage around the current video frame, marked by the dashed line. The ten
    traces are band-pass filtered at 300–6,000 Hz and vertically offset.
  </figcaption>
</figure>
